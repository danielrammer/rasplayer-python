BR2_TARGET_GENERIC_HOSTNAME="rasplayer"
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=n
BR2_TARGET_GENERIC_ISSUE="RasPlayer Buildroot appliance"
BR2_TARGET_GENERIC_GETTY=n
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON_RPI_GPIO=y
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_SETUPTOOLS=y
BR2_PACKAGE_VLC=y
BR2_PACKAGE_FLUIDSYNTH=y
BR2_PACKAGE_FLUIDSYNTH_ALSA_LIB=y
BR2_PACKAGE_FLUIDSYNTH_JACK2=n
BR2_PACKAGE_FLUIDSYNTH_PULSEAUDIO=n
BR2_PACKAGE_FLUIDSYNTH_SDL2=n
BR2_PACKAGE_FLUIDSYNTH_DBUS=n
BR2_PACKAGE_FLUID_SOUNDFONT=y
BR2_PACKAGE_PYTHON_VLC=y
BR2_PACKAGE_PYTHON_PYFLUIDSYNTH=y
BR2_PACKAGE_PYTHON_RASPLAYER_PYGAME=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_LIBTOMCRYPT=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_RASPLAYER_PATH)/board/rasplayer-pi3bplus/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_RASPLAYER_PATH)/board/rasplayer-pi3bplus/cmdline.txt"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="bcmrpi3"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RASPLAYER_PATH)/board/rasplayer-pi3bplus/kernel.config"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RASPLAYER_PATH)/board/rasplayer-pi3bplus/rootfs-overlay"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RASPLAYER_PATH)/board/rasplayer-pi3bplus/users.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RASPLAYER_PATH)/board/rasplayer-pi3bplus/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RASPLAYER_PATH)/board/rasplayer-pi3bplus/post-image.sh"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="768M"
BR2_TARGET_ROOTFS_TAR=n
BR2_TARGET_ROOTFS_EXT2_LABEL="rasplayer-root"
BR2_PACKAGE_RASPLAYER=y
