#!/bin/sh

# Persist post-LOCAL_READY state where it can be recovered without SSH. This
# runs only in background/error paths and is not part of local readiness.
REASON=${1:-periodic}
LOG_DIR=/var/lib/rasplayer/logs
REPORT=${LOG_DIR}/rasplayer-diagnostics.txt
TMP=${REPORT}.$$.tmp
BOOT_MOUNT=/mnt/boottrace
LOCK=/run/boottrace/fat.lock

mkdir -p "${LOG_DIR}" "${BOOT_MOUNT}" /run/boottrace
read -r uptime _ < /proc/uptime || uptime=unknown
{
    echo "RasPlayer persistent diagnostics"
    echo "reason=${REASON} uptime=${uptime}"
    uname -a
    echo
    echo "--- processes ---"
    ps
    echo
    echo "--- RasPlayer service state ---"
    service_status=0
    /etc/init.d/S50rasplayer status 2>&1 || service_status=$?
    echo "service_status_exit=${service_status}"
    printf 'active_release='; readlink /opt/rasplayer/current 2>/dev/null || echo missing
    printf 'previous_release='; readlink /opt/rasplayer/previous 2>/dev/null || echo missing
    ls -ldn /opt/rasplayer /opt/rasplayer/releases \
        /usr/bin/rasplayer-service /usr/sbin/rasplayer-deploy \
        /etc/rasplayer-update-public.pem 2>&1 || true
    if [ -s /home/dnl/work/rasplayer-update/manifest ]; then
        grep -E '^(format|release)=' /home/dnl/work/rasplayer-update/manifest 2>/dev/null || true
    fi
    for pid_file in /run/rasplayer/manager.pid /run/rasplayer/rasplayer.pid \
        /run/rasplayer/ready-watch.pid; do
        echo "pid_file=${pid_file} value=$(cat "${pid_file}" 2>/dev/null || echo missing)"
        service_pid=$(cat "${pid_file}" 2>/dev/null || true)
        case "${service_pid}" in
            ''|*[!0-9]*) ;;
            *)
                printf 'pid=%s cmdline=' "${service_pid}"
                tr '\000' ' ' < "/proc/${service_pid}/cmdline" 2>/dev/null || echo missing
                echo
                grep -E '^(Name|State|Pid|PPid):' "/proc/${service_pid}/status" 2>/dev/null || true
                ;;
        esac
    done
    echo
    echo "--- modules ---"
    lsmod 2>&1 || true
    echo
    echo "--- network ---"
    ip link 2>&1 || true
    ip -4 addr 2>&1 || true
    ip route 2>&1 || true
    echo
    echo "--- provisioning and association ---"
    cat /run/rasplayer/provision.status 2>&1 || true
    /usr/sbin/wpa_cli -p /var/run/wpa_supplicant -i wlan0 status 2>&1 || true
    netstat -ltn 2>&1 || true
    printf 'dropbear_key_dir_link='; readlink /etc/dropbear 2>/dev/null || echo not_symlink
    ls -ldn /etc/dropbear /var/run/dropbear \
        /etc/dropbear/dropbear_*_host_key 2>&1 || true
    printf 'entropy_avail='; cat /proc/sys/kernel/random/entropy_avail 2>/dev/null || echo unknown
    echo
    echo "--- runtime files ---"
    ls -l /dev/gpiomem /dev/mem /sys/class/net/wlan0 \
        /run/rasplayer /run/wpa_supplicant.wlan0.pid \
        /run/udhcpc.wlan0.pid 2>&1 || true
    echo
    echo "--- boot events ---"
    cat /run/boottrace/events.log 2>&1 || true
    echo
    echo "--- RasPlayer supervisor log ---"
    tail -n 100 "${LOG_DIR}/rasplayer-supervisor.log" 2>&1 || true
    echo
    echo "--- RasPlayer log ---"
    tail -n 300 "${LOG_DIR}/rasplayer.log" 2>&1 || true
    echo
    echo "--- network log ---"
    tail -n 300 "${LOG_DIR}/rasplayer-network.log" 2>&1 || true
    echo
    echo "--- wpa_supplicant log ---"
    tail -n 300 "${LOG_DIR}/wpa_supplicant.log" 2>&1 || true
    echo
    echo "--- Dropbear supervisor log ---"
    tail -n 100 "${LOG_DIR}/dropbear-supervisor.log" 2>&1 || true
    echo
    echo "--- kernel tail ---"
    dmesg | tail -n 300
} >"${TMP}"
mv "${TMP}" "${REPORT}"

tries=0
while ! mkdir "${LOCK}" 2>/dev/null; do
    tries=$((tries + 1))
    [ "${tries}" -lt 100 ] || exit 0
    sleep 0.1
done

if mount -t vfat -o rw,noatime /dev/mmcblk0p1 "${BOOT_MOUNT}" 2>/dev/null; then
    cp "${REPORT}" "${BOOT_MOUNT}/rasplayer-diagnostics.txt.tmp"
    sync
    mv "${BOOT_MOUNT}/rasplayer-diagnostics.txt.tmp" \
        "${BOOT_MOUNT}/rasplayer-diagnostics.txt"
    sync
    umount "${BOOT_MOUNT}"
fi
rmdir "${LOCK}"
